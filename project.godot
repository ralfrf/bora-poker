; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bora Poker"
config/description="Texas Hold'em com amigos e offline, sem dinheiro real."
run/main_scene="res://ui/app/main.tscn"
run/low_processor_mode=true
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://ui/icon/icon.png"
boot_splash/bg_color=Color(0.019607844, 0.02745098, 0.050980393, 1)
boot_splash/image="res://ui/icon/splash.png"

[display]

window/size/viewport_width=800
window/size/viewport_height=360
window/size/window_width_override=915
window/size/window_height_override=412
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_2d=0
textures/vram_compression/import_etc2_astc=true
